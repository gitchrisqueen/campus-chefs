# Optional overrides only. Every value below is empty or its default.
# Secrets are generated by the `keygen` service on first run.
# Never add a secret to this file.
WEB_PORT=8000
CC_DEMO_MODE=true
CC_REGISTRATION_OPEN=true
CC_AI_ENABLED=false
CC_AI_MODEL=
# The Anthropic API key never goes in this file. Put it in a file of its own and name that file
# in ANTHROPIC_API_KEY_FILE, as docs/OPERATIONS.md shows.
CC_FEEDBACK_URL=
